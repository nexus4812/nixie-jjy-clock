(version 1)
(rule hv_to_lv (constraint clearance (min 2.5mm)) (condition "A.hasNetclass('HV') && !B.hasNetclass('HV') && !B.hasNetclass('CATHODE')"))
(rule hv_to_cathode (constraint clearance (min 1.5mm)) (condition "A.hasNetclass('HV') && B.hasNetclass('CATHODE')"))
(rule cathode_to_lv (constraint clearance (min 0.9mm)) (condition "A.hasNetclass('CATHODE') && !B.hasNetclass('CATHODE') && !B.hasNetclass('HV')"))
(rule hv_edge (constraint edge_clearance (min 1.5mm)) (condition "A.hasNetclass('HV')"))
(rule hv_hole (constraint hole_clearance (min 2.5mm)) (condition "A.hasNetclass('HV') && B.Pad_Type == 'NPTH, mechanical'"))
# TO-92のコレクター/ベース端子間隔の制約。R08で現物評価
(rule package_Q4 (constraint clearance (min 1.0mm)) (condition "A.NetName == 'NEON_CATHODES' && B.NetName == 'COLON_BASE'"))
